v_integrity_violations	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `v_integrity_violations` AS with parent_scan as (select `club_version`.`club_id` AS `club_id`,`club_version`.`version_id` AS `version_id`,`club_version`.`valid_from` AS `valid_from`,`club_version`.`valid_to` AS `valid_to`,max(`club_version`.`valid_to`) over ( partition by `club_version`.`club_id` order by `club_version`.`valid_from`,`club_version`.`version_id` rows between  unbounded  preceding  and 1 preceding ) AS `prior_end` from `club_version` where `club_version`.`tx_to` = '9999-12-31 23:59:59.999999'), marked as (select `parent_scan`.`club_id` AS `club_id`,`parent_scan`.`version_id` AS `version_id`,`parent_scan`.`valid_from` AS `valid_from`,`parent_scan`.`valid_to` AS `valid_to`,`parent_scan`.`prior_end` AS `prior_end`,case when `parent_scan`.`prior_end` is null or `parent_scan`.`prior_end` < `parent_scan`.`valid_from` then 1 else 0 end AS `new_island` from `parent_scan`), numbered as (select `marked`.`club_id` AS `club_id`,`marked`.`version_id` AS `version_id`,`marked`.`valid_from` AS `valid_from`,`marked`.`valid_to` AS `valid_to`,`marked`.`prior_end` AS `prior_end`,`marked`.`new_island` AS `new_island`,sum(`marked`.`new_island`) over ( partition by `marked`.`club_id` order by `marked`.`valid_from`,`marked`.`version_id` rows between  unbounded  preceding  and  current row ) AS `island_id` from `marked`), parent_union as (select `numbered`.`club_id` AS `club_id`,`numbered`.`island_id` AS `island_id`,min(`numbered`.`valid_from`) AS `valid_from`,max(`numbered`.`valid_to`) AS `valid_to` from `numbered` group by `numbered`.`club_id`,`numbered`.`island_id`)select 'I1' AS `invariant_code`,'club_version' AS `source_table`,`a`.`club_id` AS `business_key`,`a`.`version_id` AS `version_id`,`b`.`version_id` AS `conflicting_version_id`,concat('club_id=',`a`.`club_id`,': overlapping current valid periods') AS `details` from (`club_version` `a` join `club_version` `b` on(`a`.`club_id` = `b`.`club_id` and `a`.`version_id` < `b`.`version_id` and `a`.`valid_from` < `b`.`valid_to` and `b`.`valid_from` < `a`.`valid_to`)) where `a`.`tx_to` = '9999-12-31 23:59:59.999999' and `b`.`tx_to` = '9999-12-31 23:59:59.999999' union all select 'I1' AS `invariant_code`,'contract_version' AS `source_table`,`a`.`contract_id` AS `business_key`,`a`.`version_id` AS `version_id`,`b`.`version_id` AS `conflicting_version_id`,concat('contract_id=',`a`.`contract_id`,': overlapping current valid periods') AS `details` from (`contract_version` `a` join `contract_version` `b` on(`a`.`contract_id` = `b`.`contract_id` and `a`.`version_id` < `b`.`version_id` and `a`.`valid_from` < `b`.`valid_to` and `b`.`valid_from` < `a`.`valid_to`)) where `a`.`tx_to` = '9999-12-31 23:59:59.999999' and `b`.`tx_to` = '9999-12-31 23:59:59.999999' union all select 'I1' AS `invariant_code`,'head_coach_role_version' AS `source_table`,`a`.`role_id` AS `business_key`,`a`.`version_id` AS `version_id`,`b`.`version_id` AS `conflicting_version_id`,concat('role_id=',`a`.`role_id`,': overlapping current valid periods') AS `details` from (`head_coach_role_version` `a` join `head_coach_role_version` `b` on(`a`.`role_id` = `b`.`role_id` and `a`.`version_id` < `b`.`version_id` and `a`.`valid_from` < `b`.`valid_to` and `b`.`valid_from` < `a`.`valid_to`)) where `a`.`tx_to` = '9999-12-31 23:59:59.999999' and `b`.`tx_to` = '9999-12-31 23:59:59.999999' union all select 'I2' AS `I2`,'contract_version' AS `contract_version`,`v`.`contract_id` AS `contract_id`,`v`.`version_id` AS `version_id`,cast(NULL as unsigned) AS `CAST(NULL AS UNSIGNED)`,concat('contract_id=',`v`.`contract_id`,': club_id=',`a`.`club_id`,' does not cover [',`v`.`valid_from`,',',`v`.`valid_to`,')') AS `Name_exp_6` from (`contract_version` `v` join `contract` `a` on(`a`.`contract_id` = `v`.`contract_id`)) where `v`.`tx_to` = '9999-12-31 23:59:59.999999' and !exists(select 1 from `parent_union` `p` where `p`.`club_id` = `a`.`club_id` and `p`.`valid_from` <= `v`.`valid_from` and `v`.`valid_to` <= `p`.`valid_to` limit 1) union all select 'I2' AS `I2`,'head_coach_role_version' AS `head_coach_role_version`,`v`.`role_id` AS `role_id`,`v`.`version_id` AS `version_id`,cast(NULL as unsigned) AS `CAST(NULL AS UNSIGNED)`,concat('role_id=',`v`.`role_id`,': club_id=',`a`.`club_id`,' does not cover [',`v`.`valid_from`,',',`v`.`valid_to`,')') AS `Name_exp_6` from (`head_coach_role_version` `v` join `head_coach_role` `a` on(`a`.`role_id` = `v`.`role_id`)) where `v`.`tx_to` = '9999-12-31 23:59:59.999999' and !exists(select 1 from `parent_union` `p` where `p`.`club_id` = `a`.`club_id` and `p`.`valid_from` <= `v`.`valid_from` and `v`.`valid_to` <= `p`.`valid_to` limit 1) union all select 'I3' AS `I3`,'head_coach_role_version' AS `head_coach_role_version`,`ra`.`club_id` AS `club_id`,`a`.`version_id` AS `version_id`,`b`.`version_id` AS `version_id`,concat('club_id=',`ra`.`club_id`,': multiple current head coach assignments') AS `Name_exp_6` from (((`head_coach_role_version` `a` join `head_coach_role` `ra` on(`ra`.`role_id` = `a`.`role_id`)) join `head_coach_role` `rb` on(`rb`.`club_id` = `ra`.`club_id`)) join `head_coach_role_version` `b` on(`b`.`role_id` = `rb`.`role_id` and `a`.`version_id` < `b`.`version_id` and `a`.`valid_from` < `b`.`valid_to` and `b`.`valid_from` < `a`.`valid_to`)) where `a`.`tx_to` = '9999-12-31 23:59:59.999999' and `b`.`tx_to` = '9999-12-31 23:59:59.999999'	utf8mb4	utf8mb4_uca1400_ai_ci
