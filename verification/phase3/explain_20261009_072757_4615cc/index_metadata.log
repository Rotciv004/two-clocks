Table	Create Table
contract_version	CREATE TABLE `contract_version` (
  `version_id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `contract_id` bigint(20) unsigned NOT NULL,
  `agreement_kind` varchar(9) NOT NULL,
  `salary_eur` decimal(12,2) NOT NULL,
  `valid_from` date NOT NULL,
  `valid_to` date NOT NULL DEFAULT '9999-12-31',
  `tx_from` datetime(6) NOT NULL,
  `tx_to` datetime(6) NOT NULL DEFAULT '9999-12-31 23:59:59.999999',
  `tx_id` bigint(20) unsigned NOT NULL,
  PRIMARY KEY (`version_id`),
  KEY `ix_contract_version_asof` (`contract_id`,`tx_to`,`valid_from`),
  KEY `ix_contract_version_tx` (`tx_id`),
  CONSTRAINT `fk_contract_version_contract_id` FOREIGN KEY (`contract_id`) REFERENCES `contract` (`contract_id`),
  CONSTRAINT `fk_contract_version_tx_id` FOREIGN KEY (`tx_id`) REFERENCES `tx_registry` (`tx_id`),
  CONSTRAINT `ck_contract_version_valid` CHECK (`valid_from` < `valid_to`),
  CONSTRAINT `ck_contract_version_tx` CHECK (`tx_from` < `tx_to`),
  CONSTRAINT `ck_contract_version_kind` CHECK (`agreement_kind` in ('PERMANENT','LOAN')),
  CONSTRAINT `ck_contract_version_salary` CHECK (`salary_eur` >= 0)
) ENGINE=InnoDB AUTO_INCREMENT=99 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
