  CREATE TEMPORARY TABLE tc_dataset_actual AS SELECT COUNT(*) AS c1 FROM player WHERE 1=1;
  IF (SELECT COUNT(*) FROM tc_dataset_actual) <> 1
     OR (SELECT COUNT(*) FROM tc_dataset_actual WHERE BINARY CAST(c1 AS CHAR) <=> BINARY '60') <> 1 THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'TC_DATASET: count_player';
  END IF;
  DROP TEMPORARY TABLE tc_dataset_actual;
  
