v_q7_monthly_relationships	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `v_q7_monthly_relationships` AS with recursive months as (select cast(date_format(`query_params`.`period_start`,'%Y-%m-01') as date) AS `month_start`,`query_params`.`period_start` AS `period_start`,`query_params`.`period_end` AS `period_end` from `query_params` where `query_params`.`params_id` = 1 union all select cast(`months`.`month_start` + interval 1 month as date) AS `CAST(DATE_ADD(month_start,INTERVAL 1 MONTH) AS DATE)`,`months`.`period_start` AS `period_start`,`months`.`period_end` AS `period_end` from `months` where `months`.`month_start` + interval 1 month < `months`.`period_end`), windows as (select `months`.`month_start` AS `month_start`,greatest(`months`.`month_start`,`months`.`period_start`) AS `window_start`,least(`months`.`month_start` + interval 1 month,`months`.`period_end`) AS `window_end` from `months`)select `w`.`month_start` AS `month_start`,`c`.`club_code` AS `club_code`,`w`.`window_start` AS `window_start`,`w`.`window_end` AS `window_end`,count(distinct `v`.`contract_id`) AS `relationship_count` from (((`windows` `w` join `club` `c`) left join `contract` `a` on(`a`.`club_id` = `c`.`club_id`)) left join `contract_version` `v` on(`v`.`contract_id` = `a`.`contract_id` and `v`.`tx_to` = '9999-12-31 23:59:59.999999' and `v`.`valid_from` < `w`.`window_end` and `w`.`window_start` < `v`.`valid_to`)) group by `w`.`month_start`,`c`.`club_code`,`w`.`window_start`,`w`.`window_end`	utf8mb4	utf8mb4_unicode_ci
