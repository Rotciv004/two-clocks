v_q3_event_audit	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `v_q3_event_audit` AS select `e`.`tx_id` AS `tx_id`,`e`.`event_ref` AS `event_ref`,`e`.`tx_time` AS `tx_time`,`d`.`fact_family` AS `fact_family`,`d`.`subject_code` AS `subject_code`,`e`.`event_codes` AS `event_codes`,`e`.`is_proactive` AS `is_proactive`,`e`.`is_late` AS `is_late`,`e`.`is_correction` AS `is_correction`,`d`.`effective_date` AS `effective_date`,to_days(cast(`e`.`tx_time` as date)) - to_days(`d`.`effective_date`) AS `delay_days`,greatest(-(to_days(cast(`e`.`tx_time` as date)) - to_days(`d`.`effective_date`)),0) AS `lead_days`,(select json_arrayagg(json_object('business_key',`o`.`business_key`,'value',`o`.`fact_value`,'agreement_kind',`o`.`agreement_kind`,'valid_from',`o`.`valid_from`,'valid_to',`o`.`valid_to`) order by `o`.`business_key` ASC,`o`.`valid_from` ASC,`o`.`version_id` ASC) from `v_p3_audit_old` `o` where `o`.`closing_tx_id` = `e`.`tx_id` and `o`.`fact_family` = `d`.`fact_family` and `o`.`subject_code` = `d`.`subject_code`) AS `old_values`,(select json_arrayagg(json_object('business_key',`n`.`business_key`,'value',`n`.`fact_value`,'agreement_kind',`n`.`agreement_kind`,'valid_from',`n`.`valid_from`,'valid_to',`n`.`valid_to`) order by `n`.`business_key` ASC,`n`.`valid_from` ASC,`n`.`version_id` ASC) from `v_p3_audit_facts` `n` where `n`.`tx_id` = `e`.`tx_id` and `n`.`fact_family` = `d`.`fact_family` and `n`.`subject_code` = `d`.`subject_code`) AS `new_values`,`e`.`same_time_events` AS `same_time_events`,`e`.`same_time_events` <> 1 AS `ambiguous_closure`,`e`.`reason` AS `reason` from (`v_p3_audit_events` `e` join `v_p3_audit_dates` `d` on(`d`.`tx_id` = `e`.`tx_id`))	utf8mb4	utf8mb4_unicode_ci
