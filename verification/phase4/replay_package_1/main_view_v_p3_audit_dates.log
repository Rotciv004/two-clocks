v_p3_audit_dates	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `v_p3_audit_dates` AS select `v_p3_audit_candidates`.`tx_id` AS `tx_id`,`v_p3_audit_candidates`.`fact_family` AS `fact_family`,`v_p3_audit_candidates`.`subject_code` AS `subject_code`,case when `v_p3_audit_candidates`.`fact_family` = 'HEAD_COACH' and max(`v_p3_audit_candidates`.`is_correction`) = 1 then max(`v_p3_audit_candidates`.`valid_from`) else coalesce(min(case when `v_p3_audit_candidates`.`changed_at_start` then `v_p3_audit_candidates`.`valid_from` end),min(case when `v_p3_audit_candidates`.`shortened_end` then `v_p3_audit_candidates`.`valid_to` end)) end AS `effective_date` from `v_p3_audit_candidates` group by `v_p3_audit_candidates`.`tx_id`,`v_p3_audit_candidates`.`fact_family`,`v_p3_audit_candidates`.`subject_code`	utf8mb4	utf8mb4_unicode_ci
