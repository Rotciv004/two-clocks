v_p3_audit_events	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `v_p3_audit_events` AS select `r`.`tx_id` AS `tx_id`,left(`r`.`reason`,3) AS `event_ref`,`r`.`tx_time` AS `tx_time`,`r`.`reason` AS `reason`,group_concat(`e`.`event_code` order by `e`.`event_code` ASC separator ',') AS `event_codes`,max(`e`.`event_code` = 'E2') AS `is_proactive`,max(`e`.`event_code` = 'E3') AS `is_late`,max(`e`.`event_code` = 'E4') AS `is_correction`,(select count(0) from `tx_registry` `z` where `z`.`tx_time` = `r`.`tx_time`) AS `same_time_events` from (`tx_registry` `r` join `tx_event_tag` `e` on(`r`.`tx_id` = `e`.`tx_id`)) group by `r`.`tx_id`,`r`.`reason`,`r`.`tx_time` having max(`e`.`event_code` in ('E2','E3','E4')) = 1	utf8mb4	utf8mb4_unicode_ci
