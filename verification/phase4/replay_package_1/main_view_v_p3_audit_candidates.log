v_p3_audit_candidates	CREATE ALGORITHM=TEMPTABLE DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `v_p3_audit_candidates` AS select `n`.`tx_id` AS `tx_id`,`n`.`fact_family` AS `fact_family`,`n`.`subject_code` AS `subject_code`,`n`.`valid_from` AS `valid_from`,`n`.`valid_to` AS `valid_to`,`e`.`is_correction` AS `is_correction`,!exists(select 1 from `v_p3_audit_old` `o` where `o`.`closing_tx_id` = `n`.`tx_id` and `o`.`fact_family` = `n`.`fact_family` and `o`.`subject_code` = `n`.`subject_code` and `o`.`business_key` = `n`.`business_key` and `o`.`fact_value` = `n`.`fact_value` and `o`.`agreement_kind` <=> `n`.`agreement_kind` and `o`.`valid_from` <= `n`.`valid_from` and `n`.`valid_from` < `o`.`valid_to` limit 1) AS `changed_at_start`,exists(select 1 from `v_p3_audit_old` `o` where `o`.`closing_tx_id` = `n`.`tx_id` and `o`.`fact_family` = `n`.`fact_family` and `o`.`subject_code` = `n`.`subject_code` and `o`.`business_key` = `n`.`business_key` and `n`.`valid_to` < `o`.`valid_to` limit 1) AS `shortened_end` from (`v_p3_audit_facts` `n` join `v_p3_audit_events` `e` on(`e`.`tx_id` = `n`.`tx_id`))	utf8mb4	utf8mb4_unicode_ci
