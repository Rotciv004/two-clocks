head_coach_role_version	CREATE TABLE `head_coach_role_version` (\n  `version_id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `role_id` bigint(20) unsigned NOT NULL,\n  `coach_id` bigint(20) unsigned NOT NULL,\n  `valid_from` date NOT NULL,\n  `valid_to` date NOT NULL DEFAULT '9999-12-31',\n  `tx_from` datetime(6) NOT NULL,\n  `tx_to` datetime(6) NOT NULL DEFAULT '9999-12-31 23:59:59.999999',\n  `tx_id` bigint(20) unsigned NOT NULL,\n  PRIMARY KEY (`version_id`),\n  KEY `ix_head_coach_role_version_asof` (`role_id`,`tx_to`,`valid_from`),\n  KEY `ix_head_coach_role_version_tx` (`tx_id`),\n  KEY `ix_head_coach_role_version_coach` (`coach_id`),\n  CONSTRAINT `fk_head_coach_role_version_coach_id` FOREIGN KEY (`coach_id`) REFERENCES `coach` (`coach_id`),\n  CONSTRAINT `fk_head_coach_role_version_role_id` FOREIGN KEY (`role_id`) REFERENCES `head_coach_role` (`role_id`),\n  CONSTRAINT `fk_head_coach_role_version_tx_id` FOREIGN KEY (`tx_id`) REFERENCES `tx_registry` (`tx_id`),\n  CONSTRAINT `ck_head_coach_role_version_valid` CHECK (`valid_from` < `valid_to`),\n  CONSTRAINT `ck_head_coach_role_version_tx` CHECK (`tx_from` < `tx_to`)\n) ENGINE=InnoDB AUTO_INCREMENT=24 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
