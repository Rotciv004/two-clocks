digraph TwoClocks {
 graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="1.2", splines=polyline, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Two Clocks — liga de fotbal fictivă\n12 tabele: 6 ancore + 3 versiuni + 3 tehnice"];
 node [shape=plain, fontname="DejaVu Sans"];
 edge [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#52606d", arrowsize=0.8, fontname="DejaVu Sans", fontsize=9];
subgraph cluster_anchors { label="6 ancore de domeniu — non-temporal"; style="rounded"; color="#94a3b8";
player [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>player</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="player_id" ALIGN="LEFT">player_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="player_code" ALIGN="LEFT">player_code</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD>UQ</TD></TR><TR><TD PORT="full_name" ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD></TD></TR><TR><TD PORT="birth_date" ALIGN="LEFT">birth_date</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR></TABLE>>];
coach [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>coach</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="coach_id" ALIGN="LEFT">coach_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="coach_code" ALIGN="LEFT">coach_code</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD>UQ</TD></TR><TR><TD PORT="full_name" ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD></TD></TR><TR><TD PORT="birth_date" ALIGN="LEFT">birth_date</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR></TABLE>>];
club [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>club</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="club_id" ALIGN="LEFT">club_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="club_code" ALIGN="LEFT">club_code</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD>UQ</TD></TR></TABLE>>];
season [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>season</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="season_id" ALIGN="LEFT">season_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="season_name" ALIGN="LEFT">season_name</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD>UQ</TD></TR><TR><TD PORT="period_start" ALIGN="LEFT">period_start</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="period_end" ALIGN="LEFT">period_end</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR></TABLE>>];
contract [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>contract</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT">contract_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="player_id" ALIGN="LEFT">player_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR><TR><TD PORT="club_id" ALIGN="LEFT">club_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="10">UQ(player_id, club_id)</FONT></TD></TR></TABLE>>];
head_coach_role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>head_coach_role</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="role_id" ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="club_id" ALIGN="LEFT">club_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="10">UQ(club_id)</FONT></TD></TR></TABLE>>];
}
subgraph cluster_versions { label="3 tabele de versiuni — bitemporal (VT + TT)"; style="rounded"; color="#94a3b8";
club_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dcfce7"><B>club_version</B><BR/><FONT POINT-SIZE="10">bitemporal</FONT></TD></TR><TR><TD PORT="version_id" ALIGN="LEFT">version_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="club_id" ALIGN="LEFT">club_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR><TR><TD PORT="club_name" ALIGN="LEFT">club_name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD></TD></TR><TR><TD PORT="budget_eur" ALIGN="LEFT">budget_eur</TD><TD ALIGN="LEFT">DECIMAL(14,2)</TD><TD></TD></TR><TR><TD PORT="valid_from" ALIGN="LEFT">valid_from</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="valid_to" ALIGN="LEFT">valid_to</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="tx_from" ALIGN="LEFT">tx_from</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD PORT="tx_to" ALIGN="LEFT">tx_to</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD PORT="tx_id" ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR></TABLE>>];
contract_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dcfce7"><B>contract_version</B><BR/><FONT POINT-SIZE="10">bitemporal</FONT></TD></TR><TR><TD PORT="version_id" ALIGN="LEFT">version_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT">contract_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR><TR><TD PORT="agreement_kind" ALIGN="LEFT">agreement_kind</TD><TD ALIGN="LEFT">VARCHAR(9)</TD><TD></TD></TR><TR><TD PORT="salary_eur" ALIGN="LEFT">salary_eur</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD><TD></TD></TR><TR><TD PORT="valid_from" ALIGN="LEFT">valid_from</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="valid_to" ALIGN="LEFT">valid_to</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="tx_from" ALIGN="LEFT">tx_from</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD PORT="tx_to" ALIGN="LEFT">tx_to</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD PORT="tx_id" ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR></TABLE>>];
head_coach_role_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#dcfce7"><B>head_coach_role_version</B><BR/><FONT POINT-SIZE="10">bitemporal</FONT></TD></TR><TR><TD PORT="version_id" ALIGN="LEFT">version_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="role_id" ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR><TR><TD PORT="coach_id" ALIGN="LEFT">coach_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR><TR><TD PORT="valid_from" ALIGN="LEFT">valid_from</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="valid_to" ALIGN="LEFT">valid_to</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="tx_from" ALIGN="LEFT">tx_from</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD PORT="tx_to" ALIGN="LEFT">tx_to</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD PORT="tx_id" ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>FK</TD></TR></TABLE>>];
}
subgraph cluster_technical { label="3 auxiliare tehnice — non-temporal"; labelloc=b; style="rounded"; color="#94a3b8";
tx_registry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#fef3c7"><B>tx_registry</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="tx_id" ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="tx_time" ALIGN="LEFT">tx_time</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD PORT="author" ALIGN="LEFT">author</TD><TD ALIGN="LEFT">VARCHAR(128)</TD><TD></TD></TR><TR><TD PORT="reason" ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">TEXT</TD><TD></TD></TR></TABLE>>];
tx_event_tag [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#fef3c7"><B>tx_event_tag</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="tx_id" ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK / FK</TD></TR><TR><TD PORT="event_code" ALIGN="LEFT">event_code</TD><TD ALIGN="LEFT">CHAR(2)</TD><TD>PK</TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="10">PK(tx_id, event_code); E1…E9</FONT></TD></TR></TABLE>>];
query_params [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#fef3c7"><B>query_params</B><BR/><FONT POINT-SIZE="10">non-temporal</FONT></TD></TR><TR><TD PORT="params_id" ALIGN="LEFT">params_id</TD><TD ALIGN="LEFT">TINYINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD PORT="valid_at" ALIGN="LEFT">valid_at</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="known_at" ALIGN="LEFT">known_at</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD PORT="period_start" ALIGN="LEFT">period_start</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="period_end" ALIGN="LEFT">period_end</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="10">params_id = 1; subject_id fără FK</FONT></TD></TR></TABLE>>];
}
player:player_id -> contract:player_id [arrowhead=crowodot];
club:club_id -> contract:club_id [arrowhead=crowodot];
club:club_id -> head_coach_role:club_id [arrowhead=teeodot];
club:club_id -> club_version:club_id [arrowhead=crowodot];
tx_registry:tx_id -> club_version:tx_id [arrowhead=crowodot];
contract:contract_id -> contract_version:contract_id [arrowhead=crowodot];
tx_registry:tx_id -> contract_version:tx_id [arrowhead=crowodot];
head_coach_role:role_id -> head_coach_role_version:role_id [arrowhead=crowodot];
coach:coach_id -> head_coach_role_version:coach_id [arrowhead=crowodot];
tx_registry:tx_id -> head_coach_role_version:tx_id [arrowhead=crowodot];
tx_registry:tx_id -> tx_event_tag:tx_id [arrowhead=crowodot];
legend [shape=box, style="rounded", fontsize=11, label="Legendă: PK = cheie primară; FK = cheie externă; UQ = unicitate\nCapăt || = exact 1; cerc + crow foot = 0..N; cerc + bară = 0..1\nToate coloanele NOT NULL; FK: ON DELETE/UPDATE RESTRICT\nVersiuni: VT și TT [from,to); tx_id se referă la registru\nseason și query_params nu au FK; cardinalitățile nu exprimă integritatea intervalelor"];
}
